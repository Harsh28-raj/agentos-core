# Copy to .env and fill in. Full reference: docs/CONFIGURATION.md

# --- Required ---
GROQ_API_KEY=
DATABASE_URL=postgresql://user:password@host/dbname     # Neon/Postgres (auth, logs, memory, checkpoints)
JWT_SECRET_KEY=                                          # python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=                                          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Optional features ---
TAVILY_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
ENABLE_CODE_INTERPRETER=false     # runs model-written Python on the server - read docs/SECURITY.md first

# --- Google OAuth (Gmail + Calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:10000/api/v1/integrations/google/callback
FRONTEND_URL=http://localhost:5173

# --- Tuning ---
CORS_ORIGINS=*                    # e.g. https://your-app.vercel.app,http://localhost:5173
DEFAULT_TIMEZONE=UTC              # e.g. Asia/Kolkata
CHECKPOINTER=auto                 # auto | postgres | redis | memory
# REDIS_URL=redis://localhost:6379
CONTEXT_WINDOW_MESSAGES=12
MAX_AGENT_HOPS=3
MAX_UPLOAD_MB=10
